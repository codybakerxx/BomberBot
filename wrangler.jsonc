// Cloudflare: where BomberBot is put online (docs/ONLINE.md).
// The game page (dist/index.html, built by `npm run build`) is served as a static file. Everything else goes
// to the server (src/worker.ts): /api/room/CODE is a WebSocket into an online room, one Durable Object per room;
// /api/push/... is notifications, one Durable Object (Friends) for the whole game, which keeps the phones that said yes.
{
  "name": "bomberbot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "FRIENDS", "class_name": "Friends" }
    ]
  },
  // the rooms keep nothing on disk; SQLite-backed objects are the kind Cloudflare's free plan allows
  // (Friends keeps its list and its signing key on its disk)
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] },
    { "tag": "v2", "new_sqlite_classes": ["Friends"] }
  ]
}
